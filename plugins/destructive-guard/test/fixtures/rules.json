{
  "wrappers": [
    "env",
    "sudo",
    "doas",
    "time",
    "nohup",
    "nice",
    "ionice",
    "stdbuf",
    "caffeinate",
    "watch",
    "command",
    "builtin",
    "exec",
    "coproc",
    "timeout",
    "xargs"
  ],
  "runners": [
    {
      "program": "npx",
      "valueOptions": ["-p", "--package"],
      "shellOptions": ["-c", "--call"],
      "bareBin": true
    },
    {
      "program": "pnpx",
      "valueOptions": ["-p", "--package"],
      "bareBin": true
    },
    {
      "program": "bunx",
      "valueOptions": ["-p", "--package"],
      "bareBin": true
    },
    {
      "program": "pnpm",
      "valueOptions": [
        "-C",
        "--dir",
        "-F",
        "--filter",
        "--filter-prod",
        "--workspace-dir",
        "--reporter",
        "--loglevel",
        "--test-pattern",
        "--changed-files-ignore-pattern",
        "--resume-from",
        "--workspace-concurrency",
        "--package"
      ],
      "subcommands": ["exec", "dlx", "run"],
      "shellOptions": ["-c", "--shell-mode"],
      "bareBin": true
    },
    {
      "program": "npm",
      "valueOptions": ["-w", "--workspace", "--prefix", "-p", "--package"],
      "subcommands": ["exec", "x"],
      "shellOptions": ["-c", "--call"]
    },
    {
      "program": "yarn",
      "valueOptions": ["--cwd"],
      "subcommands": ["dlx", "exec", "run"],
      "bareBin": true
    },
    {
      "program": "bun",
      "valueOptions": ["--cwd"],
      "subcommands": ["x", "run"],
      "bareBin": true
    }
  ],
  "inertPrograms": [
    "echo",
    "printf",
    "grep",
    "egrep",
    "fgrep",
    "rg",
    "which",
    "whereis",
    "type",
    "man",
    "cat",
    "head",
    "tail",
    "less",
    "wc",
    "ls",
    "stat",
    "file",
    "basename",
    "dirname",
    "realpath",
    "readlink"
  ],
  "inertUnsafeFlags": {
    "rg": ["--pre", "--hostname-bin"],
    "man": ["-P", "--pager", "-H", "--html"],
    "less": ["+!"]
  },
  "scriptPatterns": [
    "acmecloudapis\\.com",
    "@acmecloud-cloud/",
    "acmecloud\\.cloud",
    "dbhost\\.co",
    "@dbhost/dbhost-js",
    "postgres(ql)?://",
    "acmecloud-github-actions/",
    "hashicorp/setup-terraform",
    "dbhost/setup-cli"
  ],
  "scriptScanExempt": [
    ".claude/hooks/*.test.mjs",
    "scripts/*.test.mjs",
    "scripts/ticket-flow/**/*.test.mjs"
  ],
  "rules": [
    {
      "id": "cloudctl",
      "kind": "cli-allowlist",
      "programs": ["cloudctl"],
      "skipWords": ["alpha", "beta"],
      "readPrefixes": [["info"], ["version"]],
      "readSequences": [
        ["config", "list"],
        ["config", "get"],
        ["auth", "list"],
        ["logs", "read"],
        ["run", "services", "list"],
        ["run", "services", "describe"],
        ["run", "revisions", "list"],
        ["run", "revisions", "describe"],
        ["run", "jobs", "list"],
        ["run", "jobs", "describe"]
      ],
      "readVerbs": ["list", "describe", "get-iam-policy", "get-value"],
      "writeVerbs": [
        "create",
        "delete",
        "update",
        "deploy",
        "set",
        "patch",
        "import",
        "export",
        "add-iam-policy-binding",
        "remove-iam-policy-binding",
        "set-iam-policy",
        "enable",
        "disable",
        "cp",
        "mv",
        "rm",
        "rsync",
        "execute",
        "run",
        "submit",
        "start",
        "stop",
        "restart",
        "reset",
        "resize",
        "apply",
        "login",
        "activate-service-account",
        "ssh",
        "scp",
        "connect",
        "set-password",
        "call",
        "publish",
        "pause",
        "resume",
        "replace",
        "update-traffic",
        "add-metadata",
        "remove-metadata",
        "compose",
        "rollback",
        "cancel",
        "upgrade"
      ],
      "helpFlags": ["--help", "-h"],
      "helpWords": ["help"]
    },
    {
      "id": "dwh",
      "kind": "cli-allowlist",
      "programs": ["dwh"],
      "readPrefixes": [["ls"], ["show"]],
      "readSequences": [],
      "readVerbs": [],
      "writeVerbs": [],
      "helpFlags": ["--help"],
      "helpWords": ["help"]
    },
    {
      "id": "blobctl",
      "kind": "cli-allowlist",
      "programs": ["blobctl"],
      "readPrefixes": [["ls"], ["cat"], ["stat"]],
      "readSequences": [],
      "readVerbs": [],
      "writeVerbs": [],
      "helpFlags": ["--help"],
      "helpWords": ["help"]
    },
    {
      "id": "psql",
      "kind": "cli-gated",
      "programs": ["psql"],
      "gatedPrefixes": [[]],
      "helpFlags": ["--help", "-?"]
    },
    {
      "id": "pg_restore",
      "kind": "cli-gated",
      "programs": ["pg_restore"],
      "gatedPrefixes": [[]],
      "unlessFlags": ["-f", "--file"],
      "helpFlags": ["--help", "-?"]
    },
    {
      "id": "dbhost-cli",
      "kind": "cli-gated",
      "programs": ["dbhost"],
      "gatedPrefixes": [
        ["db", "push"],
        ["db", "reset"],
        ["migration", "up"],
        ["migration", "repair"],
        ["functions", "deploy"],
        ["functions", "delete"],
        ["secrets", "set"],
        ["secrets", "unset"]
      ],
      "helpFlags": ["--help", "-h"],
      "helpWords": ["help"]
    },
    {
      "id": "terraform",
      "kind": "cli-gated",
      "programs": ["terraform", "tofu"],
      "gatedPrefixes": [
        ["apply"],
        ["destroy"],
        ["import"],
        ["state", "rm"],
        ["state", "mv"],
        ["state", "push"],
        ["state", "replace-provider"],
        ["taint"],
        ["untaint"],
        ["force-unlock"],
        ["test"],
        ["refresh"],
        ["workspace", "delete"]
      ],
      "helpFlags": ["-help", "-h", "--help"]
    },
    {
      "id": "cloudctl-mcp",
      "kind": "mcp-as-cli",
      "tool": "^mcp__.*cloudctl.*__run_cloudctl_command$",
      "argsField": "args",
      "program": "cloudctl"
    },
    {
      "id": "dbhost-mcp",
      "kind": "mcp-allowlist",
      "tool": "^mcp__.*[Dd]bhost.*__(.+)$",
      "readTools": [
        "^list_",
        "^get_",
        "^search_docs$",
        "^generate_typescript_types$",
        "^query_logs$"
      ]
    }
  ]
}
