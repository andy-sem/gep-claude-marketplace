      "scriptScan": false
    },
    {
      "id": "git-history-rewrite",
      "kind": "cli-gated",
      "programs": [
        "git"
      ],
      "gatedPrefixes": [
        [
          "filter-branch"
        ],
        [
          "filter-repo"
        ]
      ],
      "dynamicArgs": "ignore",
      "scriptScan": false
    },
    {
      "id": "git-update-ref-delete",
      "kind": "cli-gated",
      "programs": [
        "git"
      ],
      "gatedPrefixes": [
        [
          "update-ref"
        ]
      ],
      "whenFlags": [
        [
          "-d"
        ]
      ],
      "dynamicArgs": "ignore",
      "scriptScan": false
    },
    {
      "id": "gh-delete",
      "kind": "cli-gated",
      "programs": [
        "gh"
      ],
      "gatedPrefixes": [
        [
          "repo",
          "delete"
        ],
        [
          "release",
          "delete"
        ],
        [
          "release",
          "delete-asset"
        ],
        [
          "secret",
          "delete"
        ],
        [
          "variable",
          "delete"
        ],
        [
          "cache",
          "delete"
        ],
        [
          "run",
          "delete"
        ],
        [
          "gist",
          "delete"
        ],
        [
          "label",
          "delete"
        ],
        [
          "ssh-key",
          "delete"
        ],
        [
          "gpg-key",
          "delete"
        ]
      ],
      "dynamicArgs": "ignore",
      "scriptScan": false
    },
    {
      "id": "gh-pr-delete-branch",
      "kind": "cli-gated",
      "programs": [
        "gh"
      ],
      "gatedPrefixes": [
        [
          "pr",
          "close"
        ],
        [
          "pr",
          "merge"
        ]
      ],
      "whenFlags": [
        [
          "--delete-branch",
          "-d"
        ]
      ],
      "shortBundles": true,
      "dynamicArgs": "ignore",
      "scriptScan": false
    },
    {
      "id": "gh-api-delete",
      "kind": "cli-gated",
      "programs": [
        "gh"
      ],
      "gatedPrefixes": [
        [
          "api"
        ]
      ],
      "whenArgs": [
        "^(--method=|-X)?DELETE$"
      ],
      "dynamicArgs": "ignore",
      "scriptScan": false
    },
    {
      "id": "terraform-destroy",
      "kind": "cli-gated",
      "programs": [
        "terraform",
        "tofu",
        "terragrunt"
      ],
      "gatedPrefixes": [
        [
          "destroy"
        ],
        [
          "state",
          "rm"
        ],
        [
          "workspace",
          "delete"
        ]
      ],
      "helpFlags": [
        "-help",
        "-h",
        "--help"
      ],
      "dynamicArgs": "ignore",
      "scriptScan": false
    },
    {
      "id": "terraform-apply-destroy",
      "kind": "cli-gated",
      "programs": [
        "terraform",
        "tofu",
        "terragrunt"
      ],
      "gatedPrefixes": [
