      "scriptScan": false
    },
    {
      "id": "helm-uninstall",
      "kind": "cli-gated",
      "programs": [
        "helm"
      ],
      "gatedPrefixes": [
        [
          "uninstall"
        ],
        [
          "delete"
        ]
      ],
      "dynamicArgs": "ignore",
      "scriptScan": false
    },
    {
      "id": "docker-prune",
      "kind": "cli-gated",
      "programs": [
        "docker",
        "podman"
      ],
      "gatedPrefixes": [
        [
          "system",
          "prune"
        ],
        [
          "volume",
          "prune"
        ],
        [
          "volume",
          "rm"
        ],
        [
          "image",
          "prune"
        ],
        [
          "container",
          "prune"
        ],
        [
          "builder",
          "prune"
        ],
        [
          "network",
          "prune"
        ]
      ],
      "dynamicArgs": "ignore",
      "scriptScan": false
    },
    {
      "id": "docker-compose-volumes",
      "kind": "cli-gated",
      "programs": [
        "docker",
        "podman",
        "docker-compose",
        "podman-compose"
      ],
      "gatedPrefixes": [
        [
          "down"
        ]
      ],
      "whenFlags": [
        [
          "-v",
          "--volumes"
        ]
      ],
      "dynamicArgs": "ignore",
      "scriptScan": false
    },
    {
      "id": "aws-delete",
      "kind": "cli-gated",
      "programs": [
        "aws"
      ],
      "gatedPrefixes": [
        []
      ],
      "whenArgs": [
        "^(delete|terminate|deregister|purge|remove)-[a-z0-9-]+$"
      ],
      "dynamicArgs": "ignore",
      "scriptScan": false
    },
    {
      "id": "aws-s3-delete",
      "kind": "cli-gated",
      "programs": [
        "aws"
      ],
      "gatedPrefixes": [
        [
          "s3",
          "rm"
        ],
        [
          "s3",
          "rb"
        ]
      ],
      "dynamicArgs": "ignore",
      "scriptScan": false
    },
    {
      "id": "az-delete",
      "kind": "cli-gated",
      "programs": [
        "az"
      ],
      "gatedPrefixes": [
        [
          "delete"
        ],
        [
          "delete-batch"
        ],
        [
          "purge"
        ]
      ],
      "dynamicArgs": "ignore",
      "scriptScan": false
    },
    {
      "id": "wrangler-delete",
      "kind": "cli-gated",
      "programs": [
        "wrangler"
      ],
      "gatedPrefixes": [
        [
          "delete"
        ]
      ],
      "dynamicArgs": "ignore",
      "scriptScan": false
    },
    {
      "id": "sql-destructive",
      "kind": "cli-gated",
      "programs": [
        "psql",
        "mysql",
        "mariadb",
        "sqlite3",
        "duckdb"
      ],
      "gatedPrefixes": [
        []
      ],
      "whenArgs": [
        "(?:\\bdrop\\s+(table|database|schema|view|materialized\\s+view|index|function|procedure|trigger|sequence|type|role|user|extension|owned|policy|publication)\\b)|(?:\\btruncate\\b)|(?:\\bdelete\\s+from\\b(?![\\s\\S]*\\bwhere\\b))|(?:\\balter\\s+table\\b[\\s\\S]*?\\bdrop\\b)"
      ],
      "ignoreCase": true,
      "matchStdin": true,
      "dynamicArgs": "ignore",
      "scriptScan": false
    },
    {
      "id": "wrangler-d1-sql",
      "kind": "cli-gated",
      "programs": [
        "wrangler"
      ],
      "gatedPrefixes": [
        [
          "d1",
          "execute"
        ]
      ],
      "whenArgs": [
        "(?:\\bdrop\\s+(table|database|schema|view|materialized\\s+view|index|function|procedure|trigger|sequence|type|role|user|extension|owned|policy|publication)\\b)|(?:\\btruncate\\b)|(?:\\bdelete\\s+from\\b(?![\\s\\S]*\\bwhere\\b))|(?:\\balter\\s+table\\b[\\s\\S]*?\\bdrop\\b)"
      ],
      "ignoreCase": true,
      "dynamicArgs": "ignore",
      "scriptScan": false
    },
    {
      "id": "mcp-destructive-tool",
      "kind": "mcp-pattern",
      "toolWords": [
        "delete",
        "drop",
        "destroy",
        "destructive",
        "remove",
        "reset",
        "truncate",
        "purge",
        "wipe",
        "erase",
        "terminate"
      ]
    },
    {
      "id": "mcp-destructive-sql",
      "kind": "mcp-pattern",
      "toolWords": [
        "sql",
        "query",
        "execute"
      ],
      "inputPattern": "(?:\\bdrop\\s+(table|database|schema|view|materialized\\s+view|index|function|procedure|trigger|sequence|type|role|user|extension|owned|policy|publication)\\b)|(?:\\btruncate\\b)|(?:\\bdelete\\s+from\\b(?![\\s\\S]*\\bwhere\\b))|(?:\\balter\\s+table\\b[\\s\\S]*?\\bdrop\\b)"
    }
  ]
}
