{
  "rules": [
    {
      "id": "rm-recursive-force",
      "kind": "cli-gated",
      "programs": [
        "rm"
      ],
      "gatedPrefixes": [
        []
      ],
      "whenFlags": [
        [
          "-r",
          "-R",
          "--recursive"
        ],
        [
          "-f",
          "--force"
        ]
      ],
      "shortBundles": true,
      "dynamicArgs": "ignore",
      "scriptScan": false
    },
    {
      "id": "find-delete",
      "kind": "cli-gated",
      "programs": [
        "find"
      ],
      "gatedPrefixes": [
        []
      ],
      "whenFlags": [
        [
          "-delete"
        ]
      ],
      "dynamicArgs": "ignore",
      "scriptScan": false
    },
    {
      "id": "shred",
      "kind": "cli-gated",
      "programs": [
        "shred",
        "srm"
      ],
      "gatedPrefixes": [
        []
      ],
      "dynamicArgs": "ignore",
      "scriptScan": false
    },
    {
      "id": "dd-output",
      "kind": "cli-gated",
      "programs": [
        "dd"
      ],
      "gatedPrefixes": [
        []
      ],
      "whenArgs": [
        "^of="
      ],
      "dynamicArgs": "ignore",
      "scriptScan": false
    },
    {
      "id": "mkfs",
      "kind": "cli-gated",
      "programs": [
        "mkfs",
        "mkfs.ext2",
        "mkfs.ext3",
        "mkfs.ext4",
        "mkfs.xfs",
        "mkfs.btrfs",
        "mkfs.vfat",
        "mkfs.fat",
        "mkfs.exfat",
        "mkfs.ntfs",
        "newfs",
        "newfs_apfs",
        "newfs_hfs",
        "wipefs"
      ],
      "gatedPrefixes": [
        []
      ],
      "dynamicArgs": "ignore",
      "scriptScan": false
    },
    {
      "id": "truncate",
      "kind": "cli-gated",
      "programs": [
        "truncate"
      ],
      "gatedPrefixes": [
        []
      ],
      "dynamicArgs": "ignore",
      "scriptScan": false
    },
    {
      "id": "diskutil-erase",
      "kind": "cli-gated",
      "programs": [
        "diskutil"
      ],
      "gatedPrefixes": [
        [
          "eraseDisk"
        ],
        [
          "eraseVolume"
        ],
        [
          "zeroDisk"
        ],
        [
          "randomDisk"
        ],
        [
          "secureErase"
        ],
        [
          "partitionDisk"
        ],
        [
          "apfs",
          "deleteVolume"
        ],
        [
          "apfs",
          "deleteContainer"
        ]
      ],
      "dynamicArgs": "ignore",
      "scriptScan": false
    },
    {
      "id": "git-push-force",
      "kind": "cli-gated",
      "programs": [
        "git"
      ],
      "gatedPrefixes": [
        [
          "push"
        ]
      ],
      "whenFlags": [
        [
          "--force",
          "-f",
          "--force-with-lease",
          "--mirror",
          "--delete",
          "-d",
          "--prune"
        ]
      ],
      "shortBundles": true,
      "helpFlags": [
        "--help",
        "-h"
      ],
      "dynamicArgs": "ignore",
      "scriptScan": false
    },
    {
      "id": "git-push-refspec",
      "kind": "cli-gated",
      "programs": [
        "git"
      ],
      "gatedPrefixes": [
        [
          "push"
        ]
      ],
      "whenArgs": [
        "^\\+",
        "^:"
      ],
      "helpFlags": [
        "--help",
        "-h"
      ],
      "dynamicArgs": "ignore",
      "scriptScan": false
    },
    {
      "id": "git-reset-hard",
      "kind": "cli-gated",
      "programs": [
        "git"
      ],
      "gatedPrefixes": [
        [
          "reset"
        ]
      ],
      "whenFlags": [
        [
          "--hard"
        ]
      ],
      "dynamicArgs": "ignore",
      "scriptScan": false
    },
    {
      "id": "git-clean",
      "kind": "cli-gated",
      "programs": [
        "git"
      ],
      "gatedPrefixes": [
        [
          "clean"
        ]
      ],
      "whenFlags": [
        [
          "-f",
          "--force"
        ]
      ],
      "unlessFlags": [
        "-n",
        "--dry-run"
      ],
      "shortBundles": true,
      "dynamicArgs": "ignore",
      "scriptScan": false
    },
    {
      "id": "git-branch-force-delete",
      "kind": "cli-gated",
      "programs": [
        "git"
      ],
      "gatedPrefixes": [
        [
          "branch"
        ]
      ],
      "whenFlags": [
        [
          "-D"
        ]
      ],
      "shortBundles": true,
      "dynamicArgs": "ignore",
      "scriptScan": false
    },
    {
      "id": "git-checkout-all",
      "kind": "cli-gated",
      "programs": [
        "git"
      ],
      "gatedPrefixes": [
        [
          "checkout"
        ]
      ],
      "whenArgs": [
        "^\\.$"
      ],
      "dynamicArgs": "ignore",
      "scriptScan": false
    },
    {
      "id": "git-restore-all",
      "kind": "cli-gated",
      "programs": [
        "git"
      ],
      "gatedPrefixes": [
        [
          "restore"
        ]
      ],
      "whenArgs": [
        "^\\.$"
      ],
      "unlessFlags": [
        "--staged",
        "-S"
      ],
      "dynamicArgs": "ignore",
      "scriptScan": false
    },
    {
      "id": "git-stash-drop",
      "kind": "cli-gated",
      "programs": [
        "git"
      ],
      "gatedPrefixes": [
        [
          "stash",
          "drop"
        ],
        [
          "stash",
          "clear"
        ]
      ],
