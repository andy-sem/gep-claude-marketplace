{
  "wrappers": [
    "env",
    "sudo",
    "time",
    "nohup",
    "command",
    "exec",
    "timeout",
    "xargs",
    "nice",
    "doas",
    "watch",
    "caffeinate",
    "builtin",
    "coproc"
  ],
  "runners": [
    {
      "program": "npx",
      "valueOptions": [
        "-p"
      ],
      "shellOptions": [
        "-c"
      ],
      "bareBin": true
    },
    {
      "program": "bunx",
      "bareBin": true
    },
    {
      "program": "pnpm",
      "valueOptions": [
        "-C",
        "--dir",
        "-F",
        "--filter"
      ],
      "subcommands": [
        "exec",
        "dlx",
        "run"
      ],
      "shellOptions": [
        "--shell-mode"
      ],
      "bareBin": true
    },
    {
      "program": "npm",
      "valueOptions": [
        "-w",
        "--workspace"
      ],
      "subcommands": [
        "exec",
        "x"
      ],
      "shellOptions": [
        "-c",
        "--call"
      ]
    },
    {
      "program": "yarn",
      "valueOptions": [
        "--cwd"
      ],
      "subcommands": [
        "dlx"
      ],
      "bareBin": true
    },
    [
      "legacy",
      "exec"
    ]
  ],
  "inertPrograms": [
    "echo",
    "which",
    "rg",
    "man",
    "grep"
  ],
  "inertUnsafeFlags": {
    "rg": [
      "--pre"
    ],
    "man": [
      "-P",
      "--pager",
      "-H",
      "--html"
    ]
  },
  "rules": [
    {
      "id": "cloudctl",
      "kind": "cli-allowlist",
      "programs": [
        "cloudctl"
      ],
      "helpFlags": [
        "--help",
        "-h"
      ],
      "helpWords": [
        "help"
      ],
      "skipWords": [
        "preview"
      ],
      "readPrefixes": [
        [
          "version"
        ]
      ],
      "readSequences": [
        [
          "config",
          "get"
        ],
        [
          "run",
          "jobs",
          "list"
        ]
      ],
      "readVerbs": [
        "list",
        "describe"
      ],
      "writeVerbs": [
        "create",
        "delete",
        "apply",
        "run",
        "ssh"
      ]
    },
    {
      "id": "blobctl",
      "kind": "cli-allowlist",
      "programs": [
        "blobctl"
      ],
      "readPrefixes": [
        [
          "ls"
        ]
      ]
    },
    {
      "id": "dbtool",
      "kind": "cli-gated",
      "programs": [
        "dbtool"
      ],
      "gatedPrefixes": [
        [
          "push"
        ],
        [
          "db",
          "reset"
        ]
      ],
      "unlessFlags": [],
      "helpFlags": [
        "--help"
      ]
    },
    {
      "id": "rawsql",
      "kind": "cli-gated",
      "programs": [
        "rawsql"
      ],
      "gatedPrefixes": [
        []
      ],
      "unlessFlags": [
        "--dry"
      ]
    },
    {
      "id": "x-mcp",
      "kind": "mcp-allowlist",
      "tool": "^mcp__x__(.+)$",
      "readTools": [
        "^list_",
        "^get_"
      ]
    },
    {
      "id": "cloudctl-mcp",
      "kind": "mcp-as-cli",
      "tool": "^mcp__cloud__run$",
      "argsField": "args",
      "program": "cloudctl"
    }
  ]
}
